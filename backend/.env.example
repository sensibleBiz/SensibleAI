NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Runtime URL must use a non-superuser, non-BYPASSRLS login. The migration
# harness automatically grants that login membership in sensible_app_role.
DATABASE_URL=postgresql://sensible_app:change-me@localhost:5432/sensible_crm
# PostgreSQL is the only CRM business-data store. Firebase credentials are used only for Auth/OTP verification.
# Outlet UUID from tenancy.outlets (seed / dev auth) for MINOP device punches locally:
BIOMETRIC_POSTGRES_OUTLET_ID=
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/sensible_crm
POSTGRES_DEV_USER_EMAIL=
POSTGRES_DEV_USER_PASSWORD=
POSTGRES_DEV_USER_NAME=PostgreSQL Developer
POSTGRES_DEV_TENANT_NAME=PostgreSQL Development
POSTGRES_DEV_TENANT_SLUG=postgres-development
POSTGRES_DEV_OUTLET_NAME=Development Outlet
POSTGRES_DEV_OUTLET_CODE=DEV

JWT_ACCESS_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ISSUER=sensible-crm-api
JWT_AUDIENCE=sensible-crm
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase SQL Connect runs in a separate Firebase project from the existing
# Auth configuration above. In Google Cloud, Application Default Credentials
# can be used instead of setting the optional client email/private key pair.
DATACONNECT_PROJECT_ID=sensiblecrm
DATACONNECT_SERVICE_ID=sensiblecrm-service
DATACONNECT_LOCATION=asia-south1
DATACONNECT_CLIENT_EMAIL=
DATACONNECT_PRIVATE_KEY=
WHATSAPP_INTEGRATED_NUMBER=
WHATSAPP_MSG91_AUTH_KEY=
WHATSAPP_API_URL=
WHATSAPP_MESSAGE_API_URL=

# CRM assistant: use a Google AI Studio key, or enable Gemini Enterprise and
# provide project/location while authenticating with Application Default Credentials.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
CRM_ASSISTANT_MODEL=gemini-3.8-flash

# Optional CRM-record retrieval in the existing assistant. Leave disabled until
# migration 0041 is applied and the indexing worker has been operated safely.
AI_RETRIEVAL_ENABLED=false
AI_AGENT_ACTIONS_ENABLED=false
AI_EMBEDDING_PROVIDER=google
AI_EMBEDDING_MODEL=models/gemini-embedding-001
AI_EMBEDDING_MODEL_VERSION=gemini-embedding-001-768-v1
AI_EMBEDDING_TIMEOUT_MS=10000
# Opt-in preview. Also requires the ai_customer_dossiers outlet feature.
AI_CUSTOMER_DOSSIERS_ENABLED=false
AI_DOSSIER_SYNTHESIS_MODEL=gemini-3.8-flash
AI_DOSSIER_MODEL_VERSION=gemini-3.8-flash-dossier-v1
AI_DOSSIER_TIMEOUT_MS=30000
AI_DOSSIER_MAX_OUTPUT_TOKENS=2048
AI_DOSSIER_MAX_INPUT_CHARS=16000
AI_DOSSIER_MAX_JOBS_PER_RUN=25
AI_DOSSIER_MAX_DAILY_PER_OUTLET=50
AI_DOSSIER_RETENTION_DAYS=90
# Set these to the selected model's current prices to record estimated spend.
AI_DOSSIER_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
AI_DOSSIER_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0

# Event gateway (PhonePe offline + invoice); set salt keys in production — do not commit real values
PHONEPE_OFFLINE_SALT_KEY_TEST=
PHONEPE_OFFLINE_SALT_KEY_PROD=
PHONEPE_OFFLINE_STORE_ID_PROD=MS2601201943099016828526
PHONEPE_OFFLINE_TERMINAL_ID_PROD=MST2601221625230088469643
PHONEPE_OFFLINE_CALLBACK_URL=
EVENT_INVOICE_API_URL=

# PhonePe Payment Gateway Standard Checkout v2 — online wallet top-ups
# SEPARATE from the Offline POS above — do NOT reuse PHONEPE_OFFLINE_* values.
# Required for top-up initiation. Omitting PHONEPE_PG_CREDITS_PER_INR disables
# top-ups until the credit-to-INR conversion is approved by the business.
PHONEPE_PG_ENABLED=false
PHONEPE_PG_PRODUCTION_ENABLED=false
PHONEPE_PG_CLIENT_ID_TEST=
PHONEPE_PG_CLIENT_SECRET_TEST=
PHONEPE_PG_CLIENT_VERSION_TEST=
PHONEPE_PG_CLIENT_ID_PROD=
PHONEPE_PG_CLIENT_SECRET_PROD=
PHONEPE_PG_CLIENT_VERSION_PROD=
PHONEPE_PG_WEBHOOK_USERNAME_TEST=
PHONEPE_PG_WEBHOOK_PASSWORD_TEST=
PHONEPE_PG_WEBHOOK_USERNAME_PROD=
PHONEPE_PG_WEBHOOK_PASSWORD_PROD=
# Compatibility tripwire. Standard Checkout v1 is unavailable; keep false.
PHONEPE_PG_LEGACY_V1_ENABLED=false
PHONEPE_PG_REDIRECT_URL=https://yourcrm.example.com/billing/topup/result
PHONEPE_PG_CALLBACK_URL=https://yourapi.example.com/api/webhooks/phonepe-pg/callback
# Credit conversion: credits granted per ₹1. Set only to the business-approved rate.
# Leave blank to block top-ups until the business approves the rate.
PHONEPE_PG_CREDITS_PER_INR=
PHONEPE_PG_MIN_AMOUNT_INR=100
PHONEPE_PG_MAX_AMOUNT_INR=50000
# UUID of the Sensible AI internal tenant whose admins can mutate global rate cards.
# Required to enable POST/PATCH/deactivate on /api/v1/billing/rate-cards.
# Omitting this env var disables all rate-card mutations (returns 503) — fail-closed.
# Never set this to a customer-tenant UUID.
BILLING_PLATFORM_ADMIN_TENANT_ID=
BIOMETRIC_INGEST_TOKEN=
BIOMAX_API_BASE_URL=http://www.biomaxpay.com/api/MobileApp
BIOMAX_DEFAULT_BIOMETRIC_ID=9768
BIOMAX_POLL_DEFAULT_OUTLET_ID=
