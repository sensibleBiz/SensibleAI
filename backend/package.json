{
  "name": "sensible-crm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "tsx --test tests/*.test.ts tests/unit/*.test.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rollback": "tsx src/db/rollback.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:auth-dev": "tsx src/db/seedDevelopmentAuth.ts",
    "db:check": "drizzle-kit check",
    "db:check-extensions": "tsx scripts/check-postgres-extensions.ts",
    "db:check-state": "tsx scripts/check-postgres-migration-state.ts",
    "audit:billing-db": "tsx scripts/audit-billing-database.ts",
    "test:unit": "tsx --test tests/*.test.ts tests/unit/*.test.ts tests/firestore-profiler/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "backfill:lead-embeddings": "tsx scripts/backfill-lead-embeddings.ts",
    "index:ai-retrieval": "tsx scripts/index-ai-retrieval.ts",
    "synthesize:ai-dossiers": "tsx scripts/synthesize-ai-customer-dossiers.ts",
    "backfill:whatsapp-stats": "tsx scripts/backfill-whatsapp-category-stats.ts",
    "migrate:whatsapp": "tsx scripts/migrate-whatsapp-to-postgres.ts",
    "migrate:user-access": "tsx scripts/migrate-user-access.ts",
    "repair:cross-project-refs": "tsx scripts/repair-cross-project-references.ts",
    "profile:firestore": "tsx tools/firestore-profiler/index.ts",
    "test:firestore-profiler": "tsx --test tests/firestore-profiler/**/*.test.ts",
    "seed:demo": "tsx scripts/seed-sensible-demo-2.ts",
    "seed:postgres-demo": "tsx scripts/seed-postgres-demo.ts",
    "seed:business-configurations": "tsx scripts/seed-business-configurations.ts",
    "verify:postgres-demo": "node scripts/verify-postgres-demo.mjs",
    "reconcile:topups": "tsx scripts/reconcile-topups.ts",
    "start": "node dist/server.js",
    "gcp-build": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1149.0",
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@google/adk": "^2.2.0",
    "@google/genai": "^2.27.0",
    "@grpc/grpc-js": "1.14.5",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.4.0",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
